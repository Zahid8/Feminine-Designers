NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key-do-not-expose
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Staff login. Use a strong password and a long random secret (e.g. `openssl rand -hex 32`).
STAFF_PASSWORD=choose-a-strong-staff-password
STAFF_SESSION_SECRET=long-random-session-secret
# Webstore (FemDes) connection for the Online Orders page. Same token as the webstore's WEBSTORE_API_TOKEN.
WEBSTORE_API_URL=https://shop.example.com
WEBSTORE_API_TOKEN=shared-long-random-token
